<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class {{capitalCaseSingularName}} extends Model
{
    use HasFactory;

    public const STATUS_INACTIVE = 0;
    public const STATUS_ACTIVE   = 1;

    /**
     * Indicates if the model should be timestamped.
     *
     * @var bool
     */
    public $timestamps = false;

    /**
     * @var string
     */
    protected $table = '{{snakeCasePluralName}}';

    /**
     * The attributes that aren't mass assignable.
     *
     * @var array
     */
    protected $guarded = [];

    /**
     * Scope a query to only include
     *
     * @param  \Illuminate\Database\Eloquent\Builder $query
     * @return \Illuminate\Database\Eloquent\Builder
     */
    public function scopeStatus($query, int|array $status)
    {
        if (is_array($status)) {
            return $query->whereIn('status', $status);
        }
        return $query->where('status', $status);
    }

    /**
     * Returns the list of statuses used for {{capitalCaseSingularName}}
     *
     * @return array
     */
    public static function getStatuses() : array
    {
        return [
            self::getStatusActive(),
            self::getStatusInactive(),
        ];
    }

     /**
     * Returns true if the {{headlineSingularName}} is active, false otherwise
     *
     * @return bool
     */
    public function isStatusActive() : bool
    {
        return $this->status == self::getStatusActive() ? true : false;
    }

    /**
     * Returns true if the {{headlineSingularName}} is archived, false otherwise
     *
     * @return bool
     */
    public function isStatusInactive() : bool
    {
        return $this->status == self::getStatusInactive() ? true : false;
    }

     /**
     * Returns the value for {{headlineSingularName}} status Active
     *
     * @return string
     */
    public static function getStatusActive(): int
    {
        return self::STATUS_ACTIVE;
    }

    /**
     * Returns the value for {{headlineSingularName}} status inactive.
     */
    public static function getStatusInactive(): int
    {
        return self::STATUS_INACTIVE;
    }
}
