{
    "name": "desino/crud-engine",
    "description": "Laravel Artisan scaffold generator for Desino CRUD modules (model, controller, migration, views, routes, translations).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crud",
        "scaffold",
        "generator",
        "desino"
    ],
    "homepage": "https://packagist.org/packages/desino/crud-engine",
    "authors": [
        {
            "name": "Desino",
            "email": "india@desino.be"
        }
    ],
    "support": {
        "issues": "https://github.com/desino/CrudEngine/issues",
        "source": "https://github.com/desino/CrudEngine"
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0 || ^14.0",
        "laravel/tinker": "*"
    },
    "autoload": {
        "psr-4": {
            "Desino\\CrudEngine\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Desino\\CrudEngine\\CrudEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}