{
    "name": "desino/crud-engine",
    "description": "Desino in-house Laravel CRUD scaffold generator for admin entities",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Desino",
            "email": "india@desino.be"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0 || ^14.0",
        "laravel/tinker": "*"
    },
    "autoload": {
        "psr-4": {
            "Desino\\CrudEngine\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Desino\\CrudEngine\\CrudEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}